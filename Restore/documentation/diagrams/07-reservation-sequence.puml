@startuml
!include theme.puml
title Séquence — création d’une réservation

actor "Employé" as Staff
participant "Frontend React" as UI
participant "ReservationController" as Controller
participant "StoreReservationRequest" as Request
participant "ReservationApplicationService" as AppService
participant "ReservationAvailabilityService" as Availability
participant "ReservationPricingService" as Pricing
participant "ReservationPolicyService" as Policy
database "Eloquent / MySQL" as DB

Staff -> UI : sélectionne client et dates
UI -> Controller : GET /reservations/available-rooms
Controller -> Availability : availableRooms(dates, reservationId?)
Availability -> DB : rechercher chevauchements actifs
Availability -> DB : rechercher maintenances actives
alt dates invalides
  Availability --> Controller : erreur de domaine 422
  Controller --> UI : message lié aux dates
else aucune chambre compatible
  Availability --> Controller : liste vide
  Controller --> UI : aucune chambre disponible
else chambres disponibles
  Availability --> Controller : chambres normalisées
  Controller --> UI : options type / étage / vue / numéro
end

Staff -> UI : choisit chambres, occupation, repas, réduction et politique
UI -> Controller : POST /reservations/calculate-price
Controller -> Pricing : calculate(payload)
Pricing -> DB : périodes et grilles tarifaires applicables
alt période absente ou chevauchante / occupation invalide
  Pricing --> Controller : erreur 422
  Controller --> UI : erreurs précises
else calcul valide
  Pricing --> Controller : détail et total autoritaires
  Controller --> UI : prévisualisation tarifaire
end

Staff -> UI : valide la création
UI -> Request : POST /reservations
Request -> Request : valider client, dates, chambres distinctes, occupation
alt validation Laravel échouée
  Request --> UI : 422 + errors
else payload valide
  Request -> Controller : données validées
  Controller -> AppService : create(data)
  AppService -> DB : BEGIN TRANSACTION
  AppService -> Availability : lockAndAssertRoomsAvailable()
  Availability -> DB : verrouiller chambres et recontrôler conflits
  alt chevauchement / maintenance / chambre dupliquée
    Availability --> AppService : erreur 409 ou 422
    AppService -> DB : ROLLBACK
    AppService --> Controller : erreur de domaine
    Controller --> UI : message métier
  else disponibilité confirmée
    AppService -> Pricing : calculate(data)
    Pricing -> DB : charger tarifs et réductions
    AppService -> Policy : normalize(data, client, total)
    AppService -> DB : créer réservation + affectations
    AppService -> DB : créer segments, repas et réduction
    AppService -> DB : COMMIT
    AppService --> Controller : réservation complète
    Controller --> UI : 201 ReservationResource
    UI -> UI : fermer le formulaire, actualiser la liste
    UI --> Staff : succès
  end
end
@enduml

