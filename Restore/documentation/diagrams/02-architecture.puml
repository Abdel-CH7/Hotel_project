@startuml
!include theme.puml
left to right direction
title Architecture générale de la solution

actor "Administrateur / Employé" as User

package "Frontend — React / Vite" {
  component "Pages métier\n& navigation" as Pages
  component "Composants partagés\n& hooks" as Components
  component "AuthContext\nProtectedRoute / AdminRoute" as FrontAuth
  component "Axios apiClient\nintercepteurs Bearer / 401" as Axios
  component "Exports, impression\n& documents PDF" as FrontDocs
  Pages --> Components
  Pages --> FrontAuth
  Pages --> Axios
  Pages --> FrontDocs
}

package "Backend — API REST Laravel 11" {
  component "Routes API" as Routes
  component "Middleware\nauth:sanctum · active · admin" as Middleware
  component "Controllers" as Controllers
  component "Form Requests\nvalidation 422" as Requests
  component "Services métier\nréservation · tarifs · paiements\nréclamations" as Services
  component "API Resources\nréponses normalisées" as Resources
  component "Eloquent ORM" as Eloquent
  component "Laravel Sanctum" as Sanctum

  Routes --> Middleware
  Middleware --> Controllers
  Middleware --> Sanctum
  Controllers --> Requests
  Controllers --> Services
  Controllers --> Resources
  Services --> Eloquent
  Resources --> Eloquent
}

database "MySQL\ndonnées relationnelles" as DB
folder "Storage public\nphotos utilisateurs\ndocuments équipements" as Storage

User --> Pages : HTTPS
Axios --> Routes : JSON / multipart\nAuthorization: Bearer <token>
Eloquent --> DB
Controllers --> Storage
Sanctum --> DB : personal_access_tokens
Resources --> Axios : JSON sécurisé

note bottom of Middleware
  Toutes les routes opérationnelles exigent un compte authentifié et actif.
  La gestion des utilisateurs ajoute le contrôle du rôle Administrateur.
end note
@enduml

