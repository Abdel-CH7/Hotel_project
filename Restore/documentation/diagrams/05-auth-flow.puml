@startuml
!include theme.puml
title Flux d’authentification et d’autorisation

start
:Saisie de l’adresse e-mail\net du mot de passe;
:POST /api/login\n(throttle 10 tentatives / minute);
if (Identifiants valides ?) then (non)
  :Réponse 422 neutre\n« Adresse e-mail ou mot de passe incorrect. »;
  stop
else (oui)
  if (Compte actif ?) then (non)
    :Réponse 403 account_inactive;
    :Aucun jeton créé;
    stop
  else (oui)
    :Création du jeton Sanctum;
    :Réponse sécurisée { token, user };
    :Stockage frontend dans API_TOKEN;
  endif
endif

:Requête API avec\nAuthorization: Bearer <token>;
if (auth:sanctum valide ?) then (non)
  :Réponse 401;
  :Suppression du jeton local\net redirection /login;
  stop
else (oui)
  if (Middleware active ?) then (non)
    :Réponse 403 account_inactive;
    :Ancien jeton inutilisable;
    stop
  else (oui)
    if (Route d’administration ?) then (oui)
      if (Rôle admin ?) then (non)
        :Réponse 403;
        stop
      else (oui)
        :Traitement autorisé;
      endif
    else (non)
      :Traitement autorisé;
    endif
  endif
endif

if (Déconnexion demandée ?) then (oui)
  :POST /api/logout;
  :Suppression du jeton Sanctum courant;
  :Nettoyage de l’authentification locale;
endif
stop
@enduml

